{
  "name": "sysml-collab-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite --host 127.0.0.1 --port 5173",
    "build:wasm": "wasm-pack build wasm --target web --out-dir ../src/wasm-pkg --release",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run build:wasm && tsc --noEmit",
    "test": "npm run build:wasm && vitest run && cargo test --manifest-path wasm/Cargo.toml",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
